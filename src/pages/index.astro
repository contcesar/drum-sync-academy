---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoHero from '../components/VideoHero.astro';
import PricingCards from '../components/PricingCards.astro';
import EventCard from '../components/EventCard.astro';
import Button from '../components/Button.astro';
import events from '../data/events.json';

// Next three upcoming events (falls back to the last three if none upcoming).
const now = new Date();
const sorted = [...events].sort((a, b) => a.date.localeCompare(b.date));
const upcoming = sorted.filter((e) => new Date(`${e.date}T23:59:59`) >= now);
const strip = (upcoming.length ? upcoming : sorted.slice(-3)).slice(0, 3);
---

<BaseLayout popup={true}>
  <!-- 1. Video hero -->
  <VideoHero />

  <!-- 2. Pricing right away -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" id="pricing">
    <div class="mb-10 max-w-2xl">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Simple plans, no fine print</h2>
      <p class="mt-4 text-lg text-gray-muted">
        Pick the commitment that fits. Every plan includes coached in-person
        sessions and time on real kits.
      </p>
    </div>
    <PricingCards variant="cta" />
  </section>

  <!-- 3. Programs teaser -->
  <section class="border-y border-border bg-surface">
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-20 sm:px-6 md:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold text-white sm:text-4xl">Programs built around how you play</h2>
        <p class="mt-4 text-lg text-gray-light">
          From weekly classes to focused one-on-one development, our programs
          are shaped by format and goal, not labels. Explore what fits your
          schedule and where you want to go.
        </p>
        <div class="mt-8">
          <Button href="/programs" variant="primary">View Programs</Button>
        </div>
      </div>
      <ul class="grid gap-4">
        {
          [
            { title: 'DSA Classes', desc: 'Group and small-format sessions on a regular schedule.', href: '/programs/classes' },
            { title: 'PDI', desc: 'Personal development track for focused, one-on-one growth.', href: '/programs/pdi' },
            { title: 'Tuition', desc: 'Clear breakdown of costs and payment options.', href: '/programs/tuition' },
          ].map((p) => (
            <li>
              <a
                href={p.href}
                class="flex items-center justify-between gap-4 rounded-2xl border border-border bg-elevated p-6 transition-colors hover:border-red"
              >
                <span>
                  <span class="block font-display text-lg font-bold text-white">{p.title}</span>
                  <span class="mt-1 block text-sm text-gray-muted">{p.desc}</span>
                </span>
                <svg class="h-5 w-5 shrink-0 text-red" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 4l6 6-6 6"/></svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. Upcoming events strip -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl font-bold text-white sm:text-4xl">Upcoming events</h2>
        <p class="mt-3 text-gray-muted">Clinics, showcases, and workshops at the academy.</p>
      </div>
      <Button href="/events" variant="secondary">All events</Button>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {strip.map((e) => <EventCard {...e} />)}
    </div>
  </section>

  <!-- 5. Final CTA band -->
  <section class="bg-red">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-16 text-center sm:px-6">
      <h2 class="max-w-2xl text-3xl font-bold text-white sm:text-4xl">
        Ready to find your sync? Start with a free assessment.
      </h2>
      <p class="max-w-xl text-white/90">
        We'll listen to where you are and map out where you want to go, no
        pressure.
      </p>
      <Button
        href="/book-assessment"
        variant="secondary"
        class="border-white bg-white !text-charcoal hover:border-white hover:bg-white/90 hover:!text-charcoal"
        >Book Your Assessment</Button
      >
    </div>
  </section>
</BaseLayout>
