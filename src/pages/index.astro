---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoHero from '../components/VideoHero.astro';
import MediaSlot from '../components/MediaSlot.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CtaBand from '../components/CtaBand.astro';
import Button from '../components/Button.astro';
import { programs } from '../data/programs.js';

const drumsOnlyPoints = [
  'Everyone here is a drummer—or becoming one.',
  'Our studio is built specifically for drumming.',
  'You’re surrounded by people who share your interest in the instrument.',
];

// Experience / community strip. Pass `src` to fill a slot (and `type: 'video'`
// + `poster` for clips); `position` sets the crop for portrait photos.
const experience = [
  {
    label: 'Drummer at the kit',
    src: '/dsa-drummer-green-kit.jpg',
    alt: 'A smiling drummer holding up drumsticks behind a green sparkle drum kit in a DSA studio room',
    position: '50% 20%',
    span: 'md:col-span-2 md:row-span-2',
  },
  {
    label: 'Kids and families',
    src: '/dsa-kids-and-families.jpg',
    alt: 'Kids, parents, and DSA instructors holding up drumsticks on the studio stage in front of the DSA logo',
    span: '',
  },
  {
    label: 'Live performance',
    src: '/dsa-drummer-performing.jpg',
    alt: 'A drummer mid-performance, sticks raised and smiling, behind a cymbal',
    position: '50% 10%',
    span: '',
  },
  {
    label: 'Adult drummer',
    src: '/dsa-adult-drummer-outdoor.jpg',
    alt: 'An adult drummer smiling while playing a green-lit kit at an outdoor event',
    position: '50% 20%',
    span: '',
  },
  {
    label: 'Outdoor show',
    src: '/dsa-live-performance-outdoor.jpg',
    alt: 'A drummer grinning at the camera while playing a white drum kit on an outdoor stage',
    position: 'center top',
    span: '',
  },
];

const teaser = [
  { ...programs.classes, href: '/programs#classes', badge: 'Most popular' },
  { ...programs.pdi, href: '/programs#pdi', badge: null },
  { ...programs.pack, href: '/programs#pack', badge: 'Best value' },
];
---

<BaseLayout popup={true}>
  <!-- 1. Hero -->
  <VideoHero />

  <!-- 2. 100% Drums-Only -->
  <section class="relative overflow-hidden" aria-labelledby="drums-only-title">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-24 sm:px-6 lg:grid-cols-2">
      <div>
        <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-red">
          100% Drums. 100% Dedicated.
        </p>
        <h2 id="drums-only-title" class="mt-4 text-4xl font-bold uppercase text-white sm:text-5xl lg:text-6xl">
          100% Drums-Only Studio
        </h2>
        <p class="mt-6 text-lg text-gray-light sm:text-xl">
          We’re not a general music school. We’re an immersive community built
          around learning, playing, and experiencing the drums.
        </p>

        <h3 class="mt-10 text-sm font-semibold uppercase tracking-wide text-white">That means:</h3>
        <ul class="mt-4 space-y-3">
          {
            drumsOnlyPoints.map((p) => (
              <li class="flex items-start gap-3 text-gray-light">
                <svg class="mt-1 h-5 w-5 shrink-0 text-red" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0Z"/></svg>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>

        <p class="mt-8 border-l-2 border-red pl-4 text-lg text-white">
          Whether you’re picking up drumsticks for the first time or building on
          skills you already have, you’re in the right place.
        </p>
      </div>

      <div>
        {/* Group of DSA drummers, kids to adults, on the studio stage. Square photo, so the
            slot is 1:1 to keep everyone in frame. */}
        <MediaSlot
          src="/dsa-community-stage.jpg"
          alt="A group of DSA drummers, teens and adults, smiling and holding drumsticks on the studio stage in front of the DSA logo and a red drum kit"
          aspect="1/1"
        />
      </div>
    </div>
  </section>

  <!-- 3. Experience / community strip -->
  <section class="border-t border-border bg-surface" aria-labelledby="experience-title">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 id="experience-title" class="text-3xl font-bold uppercase text-white sm:text-4xl">
        Learn. Play. Experience. Grow.
      </h2>
      <p class="mt-3 max-w-xl text-gray-muted">
        Kids, teens, and adults. First-timers and experienced players. One drum community.
      </p>
      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4 md:grid-rows-2">
        {
          experience.map((e) => (
            <div class={`col-span-2 sm:col-span-1 ${e.span}`}>
              <MediaSlot src={e.src} alt={e.alt} label={e.label} position={e.position} aspect="1/1" class="h-full" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Programs teaser (no prices on the homepage) -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="programs-title">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <h2 id="programs-title" class="text-3xl font-bold uppercase text-white sm:text-4xl">Our Programs</h2>
        <p class="mt-4 text-lg text-gray-light">
          Drum education built around clear curriculum, hands-on experience, and
          coaching that helps you understand what you’re playing.
        </p>
      </div>
      <Button href="/programs" variant="secondary">Explore Programs &amp; Pricing</Button>
    </div>

    <ul class="mt-10 grid gap-6 md:grid-cols-3">
      {
        teaser.map((p) => (
          <li>
            <a
              href={p.href}
              class={`group relative flex h-full flex-col rounded-2xl border bg-surface p-8 transition-colors hover:border-red ${p.id === 'pack' ? 'border-red/60' : 'border-border'}`}
            >
              {p.badge && (
                <span class="absolute -top-3 left-8 rounded-full bg-red px-3 py-1 text-xs font-semibold text-white">
                  {p.badge}
                </span>
              )}
              <h3 class="font-display text-xl font-bold text-white">{p.name}</h3>
              <p class="mt-2 text-sm font-semibold text-red">{p.tagline}</p>
              <p class="mt-4 flex-1 text-gray-muted">{p.teaser}</p>
              <span class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-white">
                Learn more
                <svg class="h-4 w-4 text-red transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 4l6 6-6 6"/></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 5. How It Works -->
  <HowItWorks />

  <!-- 6. Final CTA band -->
  {/* Alternate headings from the meeting (swap in if preferred):
        "Your Drumming Journey Starts Here."
        "Ready to Experience DSA?"
        "It's Your Time to Drum." */}
  <CtaBand
    heading="Ready to be part of the drum community? Start with a DSA Studio Tour."
    body="No pressure, no commitment—just a chance to see if we’re a good fit."
    label="Request a Tour"
  />
</BaseLayout>
