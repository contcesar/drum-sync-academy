---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { site, TOUR_URL } from '../data/site.js';

const fieldBase =
  'w-full rounded-xl border border-border bg-elevated px-4 py-3 text-gray-light placeholder:text-gray-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red';
const labelBase = 'block text-sm font-medium text-gray-light';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Drum Sync Academy. Address, phone, email, and hours. Studio visits are by appointment only."
>
  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h1 class="text-4xl font-bold text-white sm:text-5xl">Contact</h1>
      <p class="mt-5 max-w-2xl text-lg text-gray-light">
        Questions about programs, scheduling, or a visit? Send a note or reach
        us directly.
      </p>
    </div>
  </section>

  <!-- Visits by appointment -->
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6">
    <div class="flex flex-col gap-6 rounded-2xl border border-red/60 bg-gradient-to-r from-red/15 to-surface p-8 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-2xl font-bold text-white">Visits are by appointment only</h2>
        <p class="mt-2 max-w-xl text-gray-light">
          We don’t offer walk-in tours. All new DSA drummers begin with a Studio
          Tour. Request yours and we’ll personally reach out, usually within 48 hours.
        </p>
      </div>
      <Button href={TOUR_URL} variant="primary" class="shrink-0 uppercase tracking-wide">Request a Studio Tour</Button>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-2">
    <!-- Details -->
    <div>
      <h2 class="text-2xl font-bold text-white">Reach us</h2>
      <dl class="mt-6 space-y-5 text-gray-light">
        <div>
          <dt class="text-sm font-semibold text-red">Address <span class="font-normal text-gray-muted">(by appointment)</span></dt>
          <dd class="mt-1">
            {site.address.line1}, {site.address.line2}<br />
            {site.address.city}, {site.address.region} {site.address.postal}
          </dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-red">Phone</dt>
          <dd class="mt-1"><a href={site.phoneHref} class="hover:text-white">{site.phone}</a></dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-red">Email</dt>
          <dd class="mt-1"><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-red">Hours</dt>
          <dd class="mt-1 space-y-1">
            {site.hours.map((h) => <p>{h.days}: {h.time}</p>)}
          </dd>
        </div>
      </dl>

      <!-- Map embed: Drum Sync Academy, 9559 Center Ave Ste A, Rancho Cucamonga, CA 91730 -->
      <div class="mt-8 overflow-hidden rounded-2xl border border-border">
        <iframe
          title="Map to Drum Sync Academy, 9559 Center Ave Ste A, Rancho Cucamonga, CA 91730"
          src="https://www.google.com/maps?q=Drum+Sync+Academy,+9559+Center+Ave+Ste+A,+Rancho+Cucamonga,+CA+91730&output=embed"
          class="h-64 w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>

    <!-- Netlify contact form -->
    <div>
      <h2 class="text-2xl font-bold text-white">Send a message</h2>
      <p class="mt-2 text-sm text-gray-muted">
        For general questions. To schedule a visit, please
        <a href={TOUR_URL} class="font-semibold text-white underline decoration-red underline-offset-2 hover:text-red">request a Studio Tour</a>.
      </p>
      <!--
        Netlify Forms: the markup must exist at build time so Netlify can
        detect the form. data-netlify="true" + a hidden form-name input +
        a honeypot field. Submits redirect to /thank-you via action.
      -->
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thank-you"
        class="mt-6 space-y-5"
      >
        <input type="hidden" name="form-name" value="contact" />
        <!-- Honeypot: hidden from humans, catches bots. -->
        <p class="hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div>
          <label for="c-name" class={labelBase}>Name</label>
          <input id="c-name" name="name" type="text" required autocomplete="name" class={`mt-2 ${fieldBase}`} />
        </div>
        <div>
          <label for="c-email" class={labelBase}>Email</label>
          <input id="c-email" name="email" type="email" required autocomplete="email" class={`mt-2 ${fieldBase}`} />
        </div>
        <div>
          <label for="c-phone" class={labelBase}>Phone</label>
          <input id="c-phone" name="phone" type="tel" autocomplete="tel" class={`mt-2 ${fieldBase}`} />
        </div>
        <div>
          <label for="c-message" class={labelBase}>Message</label>
          <textarea id="c-message" name="message" rows="5" required class={`mt-2 ${fieldBase}`}></textarea>
        </div>

        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-xl bg-red px-6 py-3 font-display text-base font-semibold text-white transition-colors hover:bg-red-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red"
        >
          Send message
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
