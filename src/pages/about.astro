---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqItem from '../components/FaqItem.astro';
import Button from '../components/Button.astro';

// TODO: real instructor bios and photos.
const instructors = [
  { name: 'Kyle Schweikhard', role: 'Lead Instructor', bio: 'TODO: placeholder bio. Background, playing style, and teaching focus.' },
  { name: 'Instructor Name', role: 'Coach', bio: 'TODO: placeholder bio. Background, playing style, and teaching focus.' },
  { name: 'Instructor Name', role: 'Coach', bio: 'TODO: placeholder bio. Background, playing style, and teaching focus.' },
];

const faqs = [
  { q: 'How do I get started?', a: 'Book a free assessment. We listen to where you are, talk through your goals, and recommend a format and schedule.' },
  { q: 'Do I need my own drum kit?', a: 'No. TODO: placeholder. We provide kits and practice rooms on site. Many students practice here between sessions.' },
  { q: 'Should I bring my own sticks?', a: 'TODO: placeholder. Bring your own if you have a preferred pair, otherwise loaners are available at the front desk.' },
  { q: 'How are sessions scheduled?', a: 'TODO: placeholder. Group sessions run on a fixed weekly schedule; one-on-one and small-format times are booked with your coach.' },
  { q: 'Can I change or cancel my plan?', a: 'TODO: placeholder. Monthly plans are month-to-month and can be cancelled anytime. Longer plans lock in a lower rate.' },
  { q: 'What does the assessment cost?', a: 'TODO: placeholder. The assessment is free to book. Any assessment fee is applied to your first month on enrollment.' },
  { q: 'How do payments work?', a: 'Payments are handled securely by Stripe. We do not store card details on this site.' },
  { q: 'Do you teach all ages?', a: 'TODO: placeholder. Confirm age ranges and any youth-specific formats.' },
  { q: 'Where are you located and is there parking?', a: 'TODO: placeholder. Add the real address, parking notes, and transit options. See the Contact page for the map.' },
  { q: 'Do you offer make-up sessions?', a: 'TODO: placeholder. Describe the make-up and rescheduling policy.' },
];
---

<BaseLayout
  title="About & FAQ"
  description="The story behind Drum Sync Academy, our instructors, and answers to common questions."
>
  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h1 class="text-4xl font-bold text-white sm:text-5xl">About &amp; FAQ</h1>
      <p class="mt-5 max-w-2xl text-lg text-gray-light">
        Who we are, why the academy exists, and the questions we hear most.
      </p>
    </div>
  </section>

  <!-- Story + mission -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold text-white">Our story</h2>
        <p class="mt-4 text-gray-light">
          TODO: placeholder. Tell the facility story: how Drum Sync Academy
          started, what makes the space different, and the room-by-room setup
          students train in.
        </p>
        <h2 class="mt-10 text-3xl font-bold text-white">Our mission</h2>
        <p class="mt-4 text-gray-light">
          TODO: placeholder. State the mission in a sentence or two: meet each
          drummer where they are and give them the room, gear, and coaching to
          get where they want to go.
        </p>
      </div>
      <!-- Photo slots -->
      <div class="grid grid-cols-2 gap-4">
        {
          [1, 2, 3, 4].map((n) => (
            <div class="grid aspect-square place-items-center rounded-2xl border border-border bg-elevated text-xs text-gray-muted">
              [TODO: photo {n}]
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Instructors -->
  <section class="border-y border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 class="text-3xl font-bold text-white">Instructors</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          instructors.map((i) => (
            <div class="rounded-2xl border border-border bg-elevated p-6">
              <div class="grid aspect-[4/3] place-items-center rounded-xl border border-border bg-surface text-xs text-gray-muted">
                [TODO: photo]
              </div>
              <h3 class="mt-5 font-display text-lg font-bold text-white">{i.name}</h3>
              <p class="text-sm font-semibold text-red">{i.role}</p>
              <p class="mt-3 text-sm text-gray-light">{i.bio}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
    <h2 class="text-3xl font-bold text-white">Frequently asked questions</h2>
    <div class="mt-8 space-y-3">
      {
        faqs.map((f) => (
          <FaqItem question={f.q}>{f.a}</FaqItem>
        ))
      }
    </div>

    <div class="mt-12">
      <Button href="/book-assessment" variant="primary">Book Your Assessment</Button>
    </div>
  </section>
</BaseLayout>
