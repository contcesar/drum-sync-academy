---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Thank You"
  description="Thanks for reaching out to Drum Sync Academy. We'll be in touch shortly."
>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-32 text-center sm:px-6">
    <span class="grid h-16 w-16 place-items-center rounded-full bg-red text-white" aria-hidden="true">
      <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </span>
    <h1 class="mt-8 text-4xl font-bold text-white sm:text-5xl">Thanks — we got it</h1>
    <p class="mt-5 text-lg text-gray-light">
      Your message is on its way. We'll get back to you soon. In the meantime,
      take a look around.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <Button href="/" variant="primary">Back to home</Button>
      <Button href="/events" variant="secondary">See upcoming events</Button>
    </div>
  </section>
</BaseLayout>
