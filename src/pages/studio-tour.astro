---
import BaseLayout from '../layouts/BaseLayout.astro';
import TourForm from '../components/TourForm.astro';
import { site } from '../data/site.js';

// This route is the single conversion destination (TOUR_URL in src/data/site.js).
// If you rename this file, update TOUR_URL and the /book-assessment redirect in netlify.toml.

const expect = [
  'Meet a DSA team member and see the studio.',
  'Ask questions and learn how DSA works.',
  'Talk through your goals and experience so we can help find the right program and placement.',
];
---

<BaseLayout
  title="Request a Studio Tour"
  description="All new DSA drummers start with a Studio Tour. Tell us about yourself (or your drummer) and we'll personally reach out to set up your visit. Tours are by appointment only."
>
  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-red">Start Here</p>
      <h1 class="mt-3 text-4xl font-bold uppercase text-white sm:text-5xl">Request a Studio Tour</h1>
      <p class="mt-6 max-w-2xl text-lg text-gray-light sm:text-xl">
        All new DSA drummers start here. Tell us a bit about yourself (or your
        drummer) and we’ll personally reach out to set up your visit. Tours are
        by appointment only; no walk-ins.
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:py-20">
    <!-- What to expect -->
    <aside class="order-2 lg:order-1 lg:sticky lg:top-28 lg:self-start">
      <h2 class="text-2xl font-bold text-white">What happens next</h2>
      <p class="mt-4 text-gray-light">
        We personally review every request and typically respond within 48 hours.
        Scheduling is handled one-on-one, so your visit fits your goals,
        experience, and schedule.
      </p>

      <h3 class="mt-8 text-sm font-semibold uppercase tracking-wide text-white">On your tour</h3>
      <ul class="mt-4 space-y-3 text-gray-light">
        {
          expect.map((e) => (
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-4 w-4 shrink-0 text-red" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0Z"/></svg>
              <span>{e}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 rounded-2xl border border-border bg-surface p-6 text-sm text-gray-muted">
        <p class="font-semibold text-white">Questions first?</p>
        <p class="mt-2">
          Call <a href={site.phoneHref} class="text-gray-light underline hover:text-white">{site.phone}</a>
          or email <a href={`mailto:${site.email}`} class="break-all text-gray-light underline hover:text-white">{site.email}</a>.
        </p>
      </div>
    </aside>

    <div class="order-1 lg:order-2">
      <TourForm />
    </div>
  </section>
</BaseLayout>
