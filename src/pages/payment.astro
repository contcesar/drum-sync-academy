---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingCards from '../components/PricingCards.astro';

// TODO: paste the real Stripe Payment Link for the optional assessment fee.
const STRIPE_LINK_ASSESSMENT = 'STRIPE_LINK_ASSESSMENT';
---

<BaseLayout
  title="Payment"
  description="Enroll at Drum Sync Academy. Secure checkout handled by Stripe."
>
  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h1 class="text-4xl font-bold text-white sm:text-5xl">Payment</h1>
      <p class="mt-5 max-w-2xl text-lg text-gray-light">
        Choose a plan and check out securely. Payments are handled by Stripe.
        There is no backend on this site and no card details are stored here.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <!-- Each Enroll button points to a Stripe Payment Link placeholder.
         Edit the links in src/components/PricingCards.astro (see README). -->
    <PricingCards variant="enroll" />

    <!-- Optional assessment fee -->
    <div class="mt-12 flex flex-col items-start gap-4 rounded-2xl border border-border bg-surface p-8 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="font-display text-xl font-bold text-white">Assessment fee</h2>
        <p class="mt-1 text-sm text-gray-muted">
          Optional. Applied to your first month when you enroll. TODO: confirm amount.
        </p>
      </div>
      <a
        href={STRIPE_LINK_ASSESSMENT}
        class="inline-flex items-center justify-center rounded-xl border border-border px-6 py-3 font-display text-base font-semibold text-gray-light transition-colors hover:border-gray-muted hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red"
      >
        Pay assessment fee
      </a>
    </div>

    <p class="mt-10 flex items-center gap-2 text-sm text-gray-muted">
      <svg class="h-4 w-4 shrink-0 text-gray-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      Checkout is powered by Stripe. You'll leave this site to complete payment securely.
    </p>
  </section>
</BaseLayout>
