---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';

// Described by format and goal -- no beginner/intermediate/advanced labels.
const formats = [
  {
    name: 'Group Sessions',
    goal: 'Build timing and feel by playing alongside others.',
    fits: 'Anyone who learns well in a room with other drummers and a set rhythm to the week.',
    detail: 'TODO: placeholder. Weekly group sessions focused on groove, dynamics, and playing to a click.',
  },
  {
    name: 'Small-Format Coaching',
    goal: 'Get closer attention while keeping the energy of a small room.',
    fits: 'Players who want more feedback per session but still enjoy a shared setting.',
    detail: 'TODO: placeholder. Small groups with hands-on coaching and short performance reps.',
  },
  {
    name: 'One-on-One',
    goal: 'Move fast on the exact things you want to improve.',
    fits: 'Anyone with specific goals, a tight schedule, or material to prepare.',
    detail: 'TODO: placeholder. Fully personalized sessions built around your goals and songs.',
  },
];
---

<BaseLayout
  title="DSA Classes"
  description="Class formats at Drum Sync Academy, described by format and goal."
>
  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h1 class="text-4xl font-bold text-white sm:text-5xl">DSA Classes</h1>
      <p class="mt-5 max-w-2xl text-lg text-gray-light">
        We group classes by format and goal, not by level. Find the setup that
        matches how you like to learn and what you want to play.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="grid gap-6 md:grid-cols-3">
      {
        formats.map((f) => (
          <div class="flex flex-col rounded-2xl border border-border bg-surface p-8">
            <h2 class="font-display text-xl font-bold text-white">{f.name}</h2>
            <p class="mt-3 text-sm font-semibold text-red">Goal</p>
            <p class="text-gray-light">{f.goal}</p>
            <p class="mt-4 text-sm font-semibold text-red">Who it suits</p>
            <p class="text-gray-light">{f.fits}</p>
            <p class="mt-4 flex-1 text-sm text-gray-muted">{f.detail}</p>
          </div>
        ))
      }
    </div>

    <!-- Schedule -->
    <div class="mt-14 rounded-2xl border border-border bg-elevated p-8">
      <h2 class="font-display text-2xl font-bold text-white">Weekly schedule</h2>
      <p class="mt-2 text-gray-muted">TODO: placeholder schedule. Confirm real days and times.</p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[420px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-border text-gray-muted">
              <th class="py-3 pr-4 font-semibold">Day</th>
              <th class="py-3 pr-4 font-semibold">Format</th>
              <th class="py-3 font-semibold">Time</th>
            </tr>
          </thead>
          <tbody class="text-gray-light">
            <tr class="border-b border-border"><td class="py-3 pr-4">Monday</td><td class="py-3 pr-4">Group Sessions</td><td class="py-3">6:00 – 7:30 PM</td></tr>
            <tr class="border-b border-border"><td class="py-3 pr-4">Wednesday</td><td class="py-3 pr-4">Small-Format Coaching</td><td class="py-3">6:00 – 7:00 PM</td></tr>
            <tr class="border-b border-border"><td class="py-3 pr-4">Saturday</td><td class="py-3 pr-4">One-on-One</td><td class="py-3">By appointment</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap gap-4">
      <Button href="/book-assessment" variant="primary">Book Your Assessment</Button>
      <Button href="/programs/tuition" variant="secondary">See tuition</Button>
    </div>
  </section>
</BaseLayout>
