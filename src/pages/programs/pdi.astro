---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';

// Keep the name "PDI" / "P.D.I." exactly as given.
const tiers = [
  {
    name: "DSA P.D.I.",
    schedule: ['Once a week', '30 minutes', '4 weeks long'],
  },
  {
    name: 'PRO DSA P.D.I.',
    schedule: ['Once a week', '1 hour', '4 weeks long'],
    featured: true,
  },
];
---

<BaseLayout
  title="PDI"
  description="P.D.I. (Personal Drum Instruction) at Drum Sync Academy. One-to-one individual drum lessons."
>
  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h1 class="text-4xl font-bold text-white sm:text-5xl">PDI</h1>
      <p class="mt-4 text-xl text-gray-light">
        Personal Drum Instruction. One-to-one individual lessons.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6">
    <p class="text-lg text-gray-light">
      Whether you're beginning or playing gigs already, a P.D.I. is always a
      good thing. We know the best in the industry, and they are always learning
      too.
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        tiers.map((t) => (
          <div
            class={`flex flex-col rounded-2xl border bg-surface p-8 ${t.featured ? 'border-red' : 'border-border'}`}
          >
            <h2 class="font-display text-xl font-bold text-white">{t.name}</h2>
            <ul class="mt-5 space-y-3 text-gray-light">
              {t.schedule.map((s) => (
                <li class="flex items-center gap-2">
                  <svg class="h-4 w-4 shrink-0 text-red" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0Z" />
                  </svg>
                  <span>{s}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-12 text-lg text-gray-light">
      Your Pro Drum Instructor wants to know your goals, and watch how quickly
      you obtain them.
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <Button href="/book-assessment" variant="primary">Book Your Assessment</Button>
      <Button href="/contact" variant="secondary">Ask about PDI</Button>
    </div>
  </section>
</BaseLayout>
