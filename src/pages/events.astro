---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import events from '../data/events.json';

const now = new Date();
const sorted = [...events].sort((a, b) => a.date.localeCompare(b.date));
const isPast = (d: string) => new Date(`${d}T23:59:59`) < now;

const upcoming = sorted.filter((e) => !isPast(e.date));
const past = sorted.filter((e) => isPast(e.date)).reverse();
---

<BaseLayout
  title="Events"
  description="Clinics, showcases, workshops, and recitals at Drum Sync Academy."
>
  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h1 class="text-4xl font-bold text-white sm:text-5xl">Events</h1>
      <p class="mt-5 max-w-2xl text-lg text-gray-light">
        Clinics, showcases, and workshops at the academy. Add new events in
        <code class="rounded bg-elevated px-1.5 py-0.5 text-sm text-gray-light">src/data/events.json</code>.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="text-2xl font-bold text-white">Upcoming</h2>
    {
      upcoming.length ? (
        <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {upcoming.map((e) => (
            <EventCard {...e} />
          ))}
        </div>
      ) : (
        <p class="mt-4 text-gray-muted">No upcoming events right now. Check back soon.</p>
      )
    }

    {
      past.length > 0 && (
        <>
          <h2 class="mt-16 text-2xl font-bold text-white">Past</h2>
          <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {past.map((e) => (
              <EventCard {...e} past />
            ))}
          </div>
        </>
      )
    }
  </section>
</BaseLayout>
