---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import CtaBand from '../components/CtaBand.astro';
import GalleryTile from '../components/GalleryTile.astro';
import events from '../data/events.json';
import gallery from '../data/gallery.json';

// Upcoming events come from src/data/events.json (see README for the format).
// Dates that have passed drop off automatically.
type EventItem = {
  date: string;
  time?: string;
  title: string;
  description?: string;
  cta?: { label: string; href: string } | null;
};
const now = new Date();
const upcoming = (events as EventItem[])
  .filter((e) => new Date(`${e.date}T23:59:59`) >= now)
  .sort((a, b) => a.date.localeCompare(b.date));

type GalleryItem = {
  type: string;
  src: string;
  poster?: string;
  alt: string;
  caption: string;
  featured?: boolean;
};
const highlight = gallery.highlight;
const highlightItems = highlight.items as GalleryItem[];
const items = gallery.items as GalleryItem[];

const community = [
  { title: 'Student concerts', body: 'Showcases where DSA drummers share what they’ve been working on.' },
  { title: 'The Gig Program', body: 'Eligible DSA Class Drummers prepare for and perform on stage at in-house and community events.' },
  { title: 'Community gatherings', body: 'Time to hang out with other drummers, families, and the DSA team.' },
  { title: 'Special studio events', body: 'Clinics and one-off events that bring the drum community together.' },
];

const fieldBase =
  'mt-2 w-full rounded-xl border border-border bg-elevated px-4 py-3 text-gray-light placeholder:text-gray-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red aria-[invalid=true]:border-red';
---

<BaseLayout
  title="Events"
  description="Student concerts, the Gig Program, community gatherings, and special studio events at Drum Sync Academy."
>
  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h1 class="text-4xl font-bold uppercase text-white sm:text-5xl">Events</h1>
      <p class="mt-5 max-w-2xl text-lg text-gray-light sm:text-xl">
        At DSA, the experience goes beyond the lesson room. Events and community
        are a big part of what makes DSA different: places to perform, to cheer
        each other on, and to be around people who love drums as much as you do.
      </p>
    </div>
  </section>

  <!-- Community pillars -->
  <section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6" aria-label="Kinds of DSA events">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        community.map((c) => (
          <li class="rounded-2xl border border-border bg-surface p-6">
            <h2 class="font-display text-lg font-bold text-white">{c.title}</h2>
            <p class="mt-2 text-sm text-gray-muted">{c.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Upcoming -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="upcoming-title">
    <h2 id="upcoming-title" class="text-3xl font-bold uppercase text-white">Upcoming Events</h2>
    {
      upcoming.length ? (
        <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {upcoming.map((e) => (
            <EventCard {...e} />
          ))}
        </div>
      ) : (
        <div class="mt-8 rounded-2xl border border-dashed border-border bg-surface p-8 text-center">
          <p class="font-display text-lg font-semibold text-white">No dates on the calendar just yet.</p>
          <p class="mt-2 text-gray-muted">
            New events are announced here first. Join the list below and we’ll let you know.
          </p>
        </div>
      )
    }
  </section>

  <!-- Stay in the loop -->
  <section id="updates" class="border-y border-border bg-surface" aria-labelledby="updates-title">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 id="updates-title" class="text-3xl font-bold uppercase text-white">Stay in the Loop</h2>
        <p class="mt-3 text-lg text-gray-light">Get notified about upcoming events.</p>
      </div>

      <div>
        {/* TODO(DSA-email-endpoint): this posts to Netlify Forms ("event-updates") as a
            holding list. Connect it to the real mailing-list tool (Mailchimp, Klaviyo,
            etc.) or export the submissions periodically. Submit logic: src/scripts/forms.ts. */}
        <form
          id="updates-form"
          name="event-updates"
          method="POST"
          action="/thank-you"
          data-netlify="true"
          netlify-honeypot="bot-field"
          novalidate
          class="grid gap-4 sm:grid-cols-[1fr_1.4fr_auto] sm:items-end"
        >
          <input type="hidden" name="form-name" value="event-updates" />
          <p class="hidden" aria-hidden="true">
            <label>Don’t fill this out if you’re human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <div>
            <label for="u-first" class="block text-sm font-medium text-white">
              First name <span class="font-normal text-gray-muted">(optional)</span>
            </label>
            <input id="u-first" name="first_name" type="text" autocomplete="given-name" class={fieldBase} />
          </div>
          <div>
            <label for="u-email" class="block text-sm font-medium text-white">
              Email <span class="text-red" aria-hidden="true">*</span><span class="sr-only">(required)</span>
            </label>
            <input id="u-email" name="email" type="email" required autocomplete="email" inputmode="email"
              aria-describedby="u-email-error" class={fieldBase} />
          </div>
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-xl bg-red px-6 py-3 font-display text-base font-semibold text-white transition-colors hover:bg-red-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red disabled:opacity-60"
          >
            Notify me
          </button>
          <p id="u-email-error" class="hidden text-sm font-medium text-red-300 sm:col-span-3" role="alert"></p>
        </form>
        <p id="updates-success" class="hidden rounded-xl border border-red bg-elevated px-5 py-4 text-white" tabindex="-1">
          You’re on the list. We’ll let you know when new events are announced.
        </p>
      </div>
    </div>
  </section>

  <!-- Past events / gallery -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="gallery-title">
    <h2 id="gallery-title" class="text-3xl font-bold uppercase text-white">Past Events</h2>

    <!-- Highlight: outdoor performance -->
    <div class="mt-10 rounded-3xl border border-border bg-surface p-6 sm:p-8">
      <p class="text-sm font-semibold uppercase tracking-wide text-red">Highlight</p>
      <h3 class="mt-2 text-2xl font-bold text-white sm:text-3xl">{highlight.title}</h3>
      <p class="mt-3 max-w-2xl text-gray-light">{highlight.summary}</p>
      <div class="mt-8 grid gap-4 md:grid-cols-3 md:grid-rows-2">
        {
          highlightItems.map((g) => (
            <div class={g.featured ? 'md:col-span-2 md:row-span-2' : ''}>
              {/* TODO(DSA-media): outdoor performance (~400 attendees) footage. Set src in gallery.json. */}
              <GalleryTile item={g} />
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3">
      {items.map((g) => <GalleryTile item={g} />)}
    </div>
  </section>

  <CtaBand
    heading="Want to be part of it? Start with a DSA Studio Tour."
    body="No pressure, no commitment—just a chance to see if we’re a good fit."
    label="Request a Tour"
  />

  <!-- Lightbox (native <dialog>: focus trap, Esc to close, and backdrop come for free). -->
  <dialog
    id="lightbox"
    class="m-auto w-[min(92vw,72rem)] max-w-none rounded-2xl border border-border bg-charcoal p-0 text-gray-light backdrop:bg-black/85"
    aria-label="Gallery viewer"
  >
    <div class="relative">
      <button
        type="button"
        id="lightbox-close"
        class="absolute right-3 top-3 z-10 grid h-10 w-10 place-items-center rounded-lg bg-charcoal/80 text-gray-light hover:text-white"
        aria-label="Close"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
      <div id="lightbox-media" class="grid max-h-[80vh] place-items-center bg-black"></div>
      <p id="lightbox-caption" class="px-5 py-4 text-sm"></p>
    </div>
  </dialog>
</BaseLayout>

<script>
  import { submitForm } from '../scripts/forms';

  // ---- Email signup ----
  const form = document.getElementById('updates-form') as HTMLFormElement | null;
  if (form) {
    const email = form.querySelector<HTMLInputElement>('#u-email')!;
    const err = document.getElementById('u-email-error')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const setErr = (m: string | null) => {
      err.textContent = m || '';
      err.classList.toggle('hidden', !m);
      email.setAttribute('aria-invalid', m ? 'true' : 'false');
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = email.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
        setErr(val ? 'Please enter a valid email, like name@example.com.' : 'Please enter your email.');
        email.focus();
        return;
      }
      setErr(null);
      btn.disabled = true;
      try {
        await submitForm(form);
        form.classList.add('hidden');
        const ok = document.getElementById('updates-success')!;
        ok.classList.remove('hidden');
        ok.focus();
      } catch {
        setErr('Something went wrong. Please try again in a moment.');
      } finally {
        btn.disabled = false;
      }
    });
  }

  // ---- Lightbox ----
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  const media = document.getElementById('lightbox-media');
  const caption = document.getElementById('lightbox-caption');
  if (dlg && media && caption) {
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((b) =>
      b.addEventListener('click', () => {
        const { type, src, poster, alt, caption: cap } = b.dataset;
        media.replaceChildren();
        if (type === 'video') {
          const v = document.createElement('video');
          v.src = src || '';
          if (poster) v.poster = poster;
          v.controls = true;
          v.autoplay = true;
          v.playsInline = true;
          v.setAttribute('aria-label', alt || '');
          v.className = 'max-h-[80vh] w-full';
          media.append(v);
        } else {
          const img = document.createElement('img');
          img.src = src || '';
          img.alt = alt || '';
          img.className = 'max-h-[80vh] w-auto object-contain';
          media.append(img);
        }
        caption.textContent = cap || '';
        dlg.showModal();
      }),
    );
    const close = () => dlg.close();
    document.getElementById('lightbox-close')?.addEventListener('click', close);
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) close();
    });
    dlg.addEventListener('close', () => media.replaceChildren());
  }
</script>
