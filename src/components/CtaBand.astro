---
import Button from './Button.astro';
import { TOUR_URL } from '../data/site.js';

/**
 * CtaBand.astro
 * Full-width tour CTA. `tone="red"` is the bold homepage/end-of-page band;
 * `tone="surface"` is a quieter version for mid-page use.
 * The button always points at TOUR_URL.
 */
interface Props {
  heading: string;
  body?: string;
  label?: string;
  tone?: 'red' | 'surface';
}

const {
  heading,
  body = 'No pressure, no commitment—just a chance to see if we’re a good fit.',
  label = 'Request a Tour',
  tone = 'red',
} = Astro.props;

const isRed = tone === 'red';
---

<section class={isRed ? 'bg-red' : 'border-t border-border bg-surface'}>
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-16 text-center sm:px-6">
    <h2 class="max-w-3xl text-3xl font-bold text-white sm:text-4xl">{heading}</h2>
    {body && <p class={`max-w-xl ${isRed ? 'text-white/90' : 'text-gray-light'}`}>{body}</p>}
    {
      isRed ? (
        <Button
          href={TOUR_URL}
          variant="secondary"
          class="border-white bg-white !text-charcoal hover:border-white hover:bg-white/90 hover:!text-charcoal"
        >
          {label}
        </Button>
      ) : (
        <Button href={TOUR_URL} variant="primary">
          {label}
        </Button>
      )
    }
  </div>
</section>
