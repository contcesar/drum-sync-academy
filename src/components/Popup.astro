---
/**
 * Popup.astro
 * Timed modal. Rendered by BaseLayout only when `popup` is true
 * (BaseLayout enables it on Home). To run it site-wide, flip the default
 * in BaseLayout.astro to `popup = true` -- a one-line change.
 *
 * Dismissal is stored in localStorage so it stays hidden for DISMISS_DAYS.
 */

// ---- Config: edit these ----
const SESSION_NUMBER = 4; // shown in the CTA label
const CTA_HREF = '/book-assessment'; // where the CTA points
const DELAY_MS = 6000; // ~6 seconds after load
const DISMISS_DAYS = 7; // how long a dismissal lasts
const STORAGE_KEY = 'dsa-popup-dismissed';
// ----------------------------

const ctaLabel = `Session ${SESSION_NUMBER} Enroll Now`;
---

<div
  id="dsa-popup"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="dsa-popup-title"
  data-delay={DELAY_MS}
  data-key={STORAGE_KEY}
  data-days={DISMISS_DAYS}
>
  <!-- Backdrop (click outside to dismiss) -->
  <div id="dsa-popup-backdrop" class="absolute inset-0 bg-black/70" aria-hidden="true"></div>

  <!-- Card -->
  <div
    id="dsa-popup-card"
    class="relative w-full max-w-md rounded-2xl border border-border bg-elevated p-8 shadow-2xl shadow-black/60 motion-safe:animate-[dsa-pop_240ms_ease-out]"
  >
    <button
      type="button"
      id="dsa-popup-close"
      class="absolute right-4 top-4 grid h-9 w-9 place-items-center rounded-lg text-gray-muted hover:bg-surface hover:text-white focus-visible:outline-2 focus-visible:outline-red"
      aria-label="Close"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>

    <p class="text-sm font-semibold uppercase tracking-wide text-red">Enrolling now</p>
    <h2 id="dsa-popup-title" class="mt-2 text-2xl font-bold text-white">
      Seats are filling for the next session
    </h2>
    <p class="mt-3 text-gray-light">
      Lock in your spot and book a free assessment. We'll match you to the
      format and schedule that fits.
    </p>

    <a
      href={CTA_HREF}
      class="mt-6 inline-flex w-full items-center justify-center rounded-xl bg-red px-6 py-3 font-display text-base font-semibold text-white transition-colors hover:bg-red-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red"
    >
      {ctaLabel}
    </a>
  </div>
</div>

<style>
  @keyframes dsa-pop {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  const popup = document.getElementById('dsa-popup');
  if (popup) {
    const key = popup.dataset.key || 'dsa-popup-dismissed';
    const days = Number(popup.dataset.days || '7');
    const delay = Number(popup.dataset.delay || '6000');

    const isDismissed = () => {
      try {
        const until = localStorage.getItem(key);
        return until !== null && Date.now() < Number(until);
      } catch {
        return false;
      }
    };

    const dismiss = () => {
      try {
        localStorage.setItem(key, String(Date.now() + days * 864e5));
      } catch {
        /* localStorage may be blocked; ignore */
      }
      close();
    };

    const open = () => {
      popup.classList.remove('hidden');
      popup.classList.add('flex');
      document.getElementById('dsa-popup-close')?.focus();
    };

    const close = () => {
      popup.classList.add('hidden');
      popup.classList.remove('flex');
    };

    if (!isDismissed()) {
      window.setTimeout(open, delay);
    }

    document.getElementById('dsa-popup-close')?.addEventListener('click', dismiss);
    document.getElementById('dsa-popup-backdrop')?.addEventListener('click', dismiss);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !popup.classList.contains('hidden')) dismiss();
    });
  }
</script>
