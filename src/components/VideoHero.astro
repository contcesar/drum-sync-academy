---
import Button from './Button.astro';

/**
 * VideoHero.astro
 * Full-width background video with a poster fallback and a dark overlay.
 * Under prefers-reduced-motion the video is hidden and the poster image is
 * shown instead (pure CSS via Tailwind's motion-reduce/motion-safe variants).
 */
interface Props {
  heading?: string;
  subheading?: string;
  videoSrc?: string;
  poster?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  heading = 'Drum Sync Academy',
  subheading = 'In-person drum education with real kits, real rooms, and coaching that meets you where you are.',
  videoSrc = '/dsa.mp4',
  poster = '/hero-poster.jpg',
  primaryLabel = 'Book Your Assessment',
  primaryHref = '/book-assessment',
  secondaryLabel = 'View Programs',
  secondaryHref = '/programs',
} = Astro.props;
---

<section class="relative isolate flex min-h-[88vh] items-center overflow-hidden bg-charcoal">
  <!-- Background media -->
  <div class="absolute inset-0 -z-10">
    <!-- Video shows only when motion is allowed -->
    <video
      class="h-full w-full object-cover motion-reduce:hidden"
      autoplay
      muted
      loop
      playsinline
      poster={poster}
      preload="metadata"
      aria-hidden="true"
      tabindex="-1"
    >
      <source src={videoSrc} type="video/mp4" />
    </video>
    <!-- Poster image shown when reduced motion is set -->
    <img
      src={poster}
      alt=""
      class="hidden h-full w-full object-cover motion-reduce:block"
      aria-hidden="true"
    />
    <!-- Lighter overlays: darken the left (behind the text) and blend the
         bottom into the page, while keeping the right/top of the video clear. -->
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal/80 via-charcoal/35 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-charcoal via-transparent to-transparent"></div>
  </div>

  <div class="mx-auto w-full max-w-6xl px-4 py-24 sm:px-6 sm:py-28">
    <div class="max-w-2xl">
      <h1 class="text-5xl font-bold text-white sm:text-6xl lg:text-7xl">
        {heading}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-gray-light sm:text-xl">
        {subheading}
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <Button href={primaryHref} variant="primary">{primaryLabel}</Button>
        <Button href={secondaryHref} variant="secondary">{secondaryLabel}</Button>
      </div>
    </div>
  </div>
</section>
