---
/**
 * Button.astro
 * Variants:
 *   primary   -> solid red CTA
 *   secondary -> outlined gray
 * Renders an <a> when `href` is passed, otherwise a <button>.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3 text-base font-semibold font-display transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red disabled:opacity-60';

const variants: Record<string, string> = {
  primary: 'bg-red text-white hover:bg-red-hover',
  secondary:
    'border border-border text-gray-light hover:border-gray-muted hover:text-white',
};

const cls = `${base} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={cls} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cls} {...rest}>
      <slot />
    </button>
  )
}
