---
import { site } from '../data/site.js';

const year = new Date().getFullYear();

const quickLinks = [
  { label: 'Programs & Pricing', href: '/programs' },
  { label: 'Events', href: '/events' },
  { label: 'About & FAQ', href: '/about' },
  { label: 'Contact', href: '/contact' },
  { label: 'Payment', href: '/payment' },
  { label: 'Book Assessment', href: '/book-assessment' },
];

const socials = [
  { label: 'Instagram', href: site.social.instagram, path: 'M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 3.2A6.6 6.6 0 1 0 18.6 12 6.6 6.6 0 0 0 12 5.4Zm0 10.9A4.3 4.3 0 1 1 16.3 12 4.3 4.3 0 0 1 12 16.3Zm6.9-11.1a1.5 1.5 0 1 1-1.5-1.5 1.5 1.5 0 0 1 1.5 1.5Z' },
  { label: 'YouTube', href: site.social.youtube, path: 'M23 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.8-1.8C19.3 5 12 5 12 5s-7.3 0-8.8.5A2.5 2.5 0 0 0 1.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 0 0 1.8 1.8C4.7 19 12 19 12 19s7.3 0 8.8-.5a2.5 2.5 0 0 0 1.8-1.8C23 15.2 23 12 23 12Zm-13 3V9l5.2 3Z' },
  { label: 'Facebook', href: site.social.facebook, path: 'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z' },
  { label: 'TikTok', href: site.social.tiktok, path: 'M16.5 3c.3 2.1 1.5 3.8 3.5 4.2v2.6c-1.3 0-2.5-.4-3.6-1v6.2a5.6 5.6 0 1 1-5.6-5.6c.3 0 .6 0 .9.1v2.7a2.9 2.9 0 1 0 2 2.8V3Z' },
];
---

<footer class="border-t border-border bg-charcoal">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
    <!-- Brand + address -->
    <div class="md:col-span-2">
      <!-- Logo. Swap public/logo.svg for the real company logo (SVG or PNG). -->
      <img src="/logo.svg" alt="Drum Sync Academy" width="236" height="44" class="h-9 w-auto" />
      <address class="mt-4 not-italic text-sm leading-relaxed text-gray-muted">
        {/* TODO: real address */}
        {site.address.line1}, {site.address.line2}<br />
        {site.address.city}, {site.address.region} {site.address.postal}
      </address>
      <p class="mt-3 text-sm text-gray-muted">
        <a href={site.phoneHref} class="hover:text-white">{site.phone}</a><br />
        <a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a>
      </p>
    </div>

    <!-- Quick links -->
    <nav aria-label="Footer">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Quick links</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          quickLinks.map((l) => (
            <li>
              <a href={l.href} class="text-gray-muted hover:text-white">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Social -->
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-white">Follow</h2>
      <ul class="mt-4 flex gap-3">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                class="grid h-10 w-10 place-items-center rounded-lg border border-border text-gray-muted transition-colors hover:border-red hover:text-white"
                aria-label={s.label}
                rel="noopener"
                target="_blank"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={s.path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-border">
    <p class="mx-auto max-w-6xl px-4 py-6 text-center text-xs text-gray-muted sm:px-6">
      &copy; {year} Drum Sync Academy. All rights reserved.
    </p>
  </div>
</footer>
